---
import GolfBall from './GolfBall.astro';
import { AIRBNB_URL } from '../data/villa';
---
<section class="hero" aria-label="Bienvenue à la Villa Carissa">
  <div class="hero-media">
    <picture>
      <source media="(max-width: 600px)" srcset="/assets/villa-poster-mobile.webp" />
      <img src="/assets/villa-poster.webp" alt="La Villa Carissa et sa piscine privée sur le golf de Samanah" fetchpriority="high" loading="eager" width="1920" height="1080" />
    </picture>
    <video id="hero-video" autoplay muted loop playsinline preload="none" data-desktop-src="/assets/villa-carissa-film.mp4" data-mobile-src="/assets/villa-carissa-mobile.mp4" aria-hidden="true" tabindex="-1"></video>
  </div>
  <div class="hero-shade"></div>
  <div class="hero-content">
    <span class="hero-ornament" aria-hidden="true"><i></i>◇<i></i></span>
    <span class="eyebrow">VILLA PRIVÉE · GOLF DE SAMANAH</span>
    <h1>Une villa à vous.<br>Tout Marrakech à vivre.</h1>
    <a href={AIRBNB_URL} target="_blank" rel="noopener noreferrer" class="button glass">RÉSERVER SUR AIRBNB <GolfBall /></a>
  </div>
</section>
