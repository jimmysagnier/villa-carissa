---
import GolfBall from './GolfBall.astro';
import BrandLogo from './BrandLogo.astro';
import { AIRBNB_URL } from '../data/villa';
interface Props { currentPage: string }
const { currentPage } = Astro.props;
const heroHeader = currentPage === 'home' || currentPage === 'golf' || currentPage === 'city';
const links = [
  {key:'home', url:'/#la-villa', label:'La villa'},
  {key:'gallery', url:'/toutes-les-photos/', label:'La galerie'},
  {key:'golf', url:'/voyage-golfique-a-marrakech/', label:'Le golf de Samanah'},
  {key:'city', url:'/location-de-villa-a-marrakech/', label:'Marrakech'},
  {key:'contact', url:'/contact/', label:'Contact'},
];
---
<a class="skip" href="#main">Aller au contenu</a>
<header class:list={['header', {'hero-header':heroHeader}]}>
  <button class="menu-toggle" aria-label="Ouvrir le menu" aria-controls="navigation" aria-expanded="false">
    <span></span><span></span><span></span><b>MENU</b>
  </button>
  <a class="brand-signature" href="/" aria-label="Villa Carissa, accueil">
    <BrandLogo id="header" />
  </a>
  <a class="button header-cta" href={AIRBNB_URL} target="_blank" rel="noopener noreferrer" aria-label="Réserver sur Airbnb (nouvel onglet)">RÉSERVER <span aria-hidden="true"><GolfBall /></span></a>
  <button class="menu-scrim" aria-label="Fermer le menu" tabindex="-1" hidden></button>
  <nav id="navigation" aria-label="Navigation principale" inert>
    <span class="menu-eyebrow">BIENVENUE À LA VILLA CARISSA</span>
    {links.map(({key,url,label},i)=><a href={url} aria-current={currentPage===key?'page':undefined}><span class="nav-number">0{i+1}</span>{label}<span class="nav-arrow" aria-hidden="true"><GolfBall /></span></a>)}
    <div class="menu-contact"><span>UNE QUESTION SUR VOTRE SÉJOUR ?</span><a href="mailto:reservation@villacarissa-samanah.com">reservation@villacarissa-samanah.com</a></div>
  </nav>
</header>
