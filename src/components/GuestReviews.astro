---
import { AIRBNB_REVIEWS_URL, reviewSnapshot } from '../data/villa';
---
<section class="guest-reviews" aria-labelledby="reviews-title">
  <div class="review-heading"><span class="eyebrow">LEURS SÉJOURS À CARISSA</span><h2 id="reviews-title">Quelques mots<br><em>de nos voyageurs.</em></h2></div>
  <div class="review-quotes">
    <figure><span class="review-quote-mark" aria-hidden="true">“</span><blockquote>Le calme est vraiment l’un des grands atouts du lieu.</blockquote><figcaption>Soufian <span>Août 2026 · Extrait d’un avis Airbnb</span></figcaption></figure>
    <figure><span class="review-quote-mark" aria-hidden="true">“</span><blockquote>Nous avons passé un très bon séjour en famille.</blockquote><figcaption>Youssef <span>Juillet 2026 · Extrait d’un avis Airbnb</span></figcaption></figure>
  </div>
  <a class="text-link" href={AIRBNB_REVIEWS_URL} target="_blank" rel="noopener noreferrer">Lire tous les avis sur Airbnb <span aria-hidden="true">↗</span></a>
  <p class="review-source">Note globale {reviewSnapshot.rating}/5 · {reviewSnapshot.count} avis · Relevé du {reviewSnapshot.displayDate}</p>
</section>
