<form class="booking-bar" action="/contact" method="get"><div class="booking-intro"><span class="eyebrow">VOTRE PROCHAINE PARENTHÈSE</span><strong>On vous garde une place ?</strong></div><label>ARRIVÉE<input type="date" name="arrivee" aria-label="Date d’arrivée" required></label><label>DÉPART<input type="date" name="depart" aria-label="Date de départ" required></label><label>VOYAGEURS<select name="voyageurs" aria-label="Nombre de voyageurs"><option value="1" >1 personne</option><option value="2" >2 personnes</option><option value="3" >3 personnes</option><option value="4" >4 personnes</option><option value="5" >5 personnes</option><option value="6" >6 personnes</option><option value="7" >7 personnes</option><option value="8" selected>8 personnes</option></select></label><button class="button" type="submit">Organiser mon séjour <span aria-hidden="true">↗</span></button><p class="date-error" role="alert" hidden></p></form>