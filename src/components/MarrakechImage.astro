---
import type { HTMLAttributes } from 'astro/types';
import imageData from '../data/marrakech-images.json';
interface Props { name: string; alt: string; sizes?: string; eager?: boolean; }
const {name,alt,sizes='(max-width: 700px) 100vw, 33vw',eager=false}=Astro.props;
const images=imageData as Record<string,{variants:{src:string;width:number;height:number}[]}>;
const photo=images[name];
if(!photo) throw new Error(`Photographie de Marrakech inconnue : ${name}`);
const largest=photo.variants.at(-1)!;
const deferred=!eager;
const srcset=photo.variants.map(v=>`${v.src} ${v.width}w`).join(', ');
const imageProps: HTMLAttributes<'img'> & {'data-deferred-src'?:string;'data-deferred-srcset'?:string}={class:'marrakech-photo'+(deferred?' deferred-photo':''),src:deferred?'data:image/svg+xml,%3Csvg xmlns="http://www.w3.org/2000/svg"/%3E':largest.src,srcset:deferred?undefined:srcset,'data-deferred-src':deferred?largest.src:undefined,'data-deferred-srcset':deferred?srcset:undefined,sizes,width:largest.width,height:largest.height,alt,loading:eager?'eager':'lazy',fetchpriority:eager?'high':undefined,decoding:'async'};
---
{name==='hero' ? <picture>
  <source type="image/avif" media="(max-width: 700px)" srcset="/assets/marrakech/hero-portrait-720.avif 720w, /assets/marrakech/hero-portrait-1080.avif 1080w" sizes="100vw" />
  <source type="image/avif" media="(min-width: 701px)" srcset={photo.variants.map(v=>`${v.src.replace('.webp','.avif')} ${v.width}w`).join(', ')} sizes={sizes} />
  <img {...imageProps} />
</picture> : <><img {...imageProps} /><noscript><style is:inline>img.deferred-photo{display:none!important}</style><img class="marrakech-photo" src={largest.src} srcset={srcset} sizes={sizes} width={largest.width} height={largest.height} alt={alt} loading="lazy" decoding="async" /></noscript></>}
