---
import imageData from '../data/golf-images.json';
interface Props { name: string; alt: string; sizes?: string; eager?: boolean; }
const {name,alt,sizes='(max-width: 700px) 100vw, 50vw',eager=false}=Astro.props;
const images=imageData as Record<string,{variants:{src:string;width:number;height:number}[]}>;
const photo=images[name];
if(!photo) throw new Error(`Photographie de golf inconnue : ${name}`);
const largest=photo.variants.at(-1)!;
---
<img class="golf-photo" src={largest.src} srcset={photo.variants.map(v=>`${v.src} ${v.width}w`).join(', ')} sizes={sizes} width={largest.width} height={largest.height} alt={alt} loading={eager?'eager':'lazy'} fetchpriority={eager?'high':undefined} decoding="async" />
