---
import BrandLogo from './BrandLogo.astro';
import { AIRBNB_URL } from '../data/villa';
const links=[
  {href:'/#la-villa',label:'La villa'},
  {href:'/toutes-les-photos/',label:'La galerie'},
  {href:'/voyage-golfique-a-marrakech/',label:'Le golf de Samanah'},
  {href:'/location-de-villa-a-marrakech/',label:'Que faire à Marrakech'},
  {href:'/contact/',label:'Contact'},
];
---
<footer class="site-footer">
  <div class="footer-content">
    <div class="footer-identity"><a class="brand-signature" href="/" aria-label="Villa Carissa, accueil"><BrandLogo id="footer" /></a><a class="footer-booking" href={AIRBNB_URL} target="_blank" rel="noopener noreferrer">Réserver sur Airbnb</a></div>
    <nav class="footer-links" aria-label="Navigation de pied de page">{links.map(link=><a href={link.href}>{link.label}</a>)}</nav>
    <div class="footer-contact"><a href="mailto:reservation@villacarissa-samanah.com">reservation@villacarissa-samanah.com</a><a href="tel:+212668214728">+212 668 214 728</a></div>
  </div>
  <div class="footer-meta"><span>© 2026 Villa Carissa · Samanah, Marrakech</span><div><a href="/category/uncategorized/">Blog & actualités</a><a href="/mentions-legales/">Mentions légales</a></div></div>
</footer>
