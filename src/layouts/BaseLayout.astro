---
import fontFaces from '../styles/fonts.css?raw';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Dialogs from '../components/Dialogs.astro';
import '../styles/global.css';
import '../styles/hero.css';
import '../styles/villa.css';
import '../styles/refinements.css';
import '../styles/brand.css';

interface Props {
  title: string;
  description: string;
  currentPage: string;
}
const { title, description, currentPage } = Astro.props;
const canonicalUrl=new URL(Astro.url.pathname,Astro.site);
---
<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#292d25" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:url" content={canonicalUrl} />
    {currentPage!=='error' && <link rel="canonical" href={canonicalUrl} />}
    <meta property="og:image" content={new URL('/assets/villa-poster.webp', Astro.site).href} />
    <link rel="icon" href="/assets/favicon-golfer.svg" type="image/svg+xml" sizes="any" />
    <link rel="preload" href="/assets/font-1.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/assets/font-3.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/assets/font-logo.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/assets/font-4.woff2" as="font" type="font/woff2" crossorigin />
    <style is:inline set:html={fontFaces} />
  </head>
  <body class={`page-${currentPage}`}>
    <Header currentPage={currentPage} />
    <main id="main"><slot /></main>
    <Footer />
    {currentPage==='gallery' && <Dialogs />}
    <script>
      import '../scripts/app.js';
    </script>
  </body>
</html>
