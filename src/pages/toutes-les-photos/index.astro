---
import ExploreIcon from '../../components/ExploreIcon.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Photo from '../../components/Photo.astro';
import photos from '../../data/photos.json';
const groups = [
  {key:'all',name:'Toutes les photos'},
  {key:'chambre',name:'Dormir'},
  {key:'exterieur',name:'Extérieur & piscine'},
  {key:'salon',name:'Salon'},
  {key:'repas',name:'À table'},
  {key:'bain',name:'Bains'},
  {key:'golf',name:'Le domaine'},
];
// Start with the property's outdoor spaces; keep the original gallery anchors.
const order=[30,31,32,33,27,17,18,11,12,14,15,16,19,20,21,13,6,5,7,1,2,3,4,9,10,8,22,23,24,25,26,28,29,34];
const orderedPhotos = order.map(id=>photos.find(p=>p.id===id)!);
---
<BaseLayout title="Toutes les photos · Villa Carissa" description="Les photos actuelles de Villa Carissa : quatre chambres, salon, cuisine, terrasses, jardin et piscine privée à Marrakech." currentPage="gallery">
  <section class="page-intro">
    <span class="eyebrow">UNE PROMENADE DANS LA MAISON</span>
    <h1>Chaque pièce,<br><em>une invitation.</em></h1>
    <p>De la chambre au jardin, découvrez la villa en images.</p>
    <button class="text-link" data-film>Regarder le film de la villa <span aria-hidden="true">▷</span></button>
  </section>
  <section class="gallery-section section">
    <div class="filters" role="group" aria-label="Filtrer les photos">
      {groups.map(group=><button data-filter={group.key} aria-pressed={group.key==='all'?'true':'false'}>{group.name}<span>{group.key==='all'?photos.length:photos.filter(p=>p.group===group.key).length}</span></button>)}
    </div>
    <div class="gallery-grid">
      {orderedPhotos.map(photo=><button class="gallery-item" data-category={photo.group} data-src={photo.src} data-caption={photo.caption} aria-label={`Agrandir : ${photo.caption}`}>
        <Photo id={photo.id} />
        <span>{photo.caption}<b aria-hidden="true"><ExploreIcon /></b></span>
      </button>)}
    </div>
    <p class="gallery-note">Photographies de la villa provenant de son annonce Airbnb.</p>
  </section>
</BaseLayout>
