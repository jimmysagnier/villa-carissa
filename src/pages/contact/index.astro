---
import GolfBall from '../../components/GolfBall.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Photo from '../../components/Photo.astro';
import { AIRBNB_URL, AIRBNB_MESSAGE_URL } from '../../data/villa';
---
<BaseLayout title="Contact & réservation · Villa Carissa" description="Consultez les disponibilités et réservez Villa Carissa exclusivement sur Airbnb. Une question ? Contactez votre hôte." currentPage="contact">
  <section class="page-intro contact-intro">
    <h1>VOTRE PROCHAIN SÉJOUR À MARRAKECH</h1>
    <p>Une question sur la maison, une envie de vacances&nbsp;?</p>
  </section>
  <section class="contact-layout section">
    <div class="contact-aside">
      <Photo id={30} sizes="(max-width:600px) 100vw, 45vw" />
      <h2>Restons en contact.</h2>
      <p>Villa Carissa<br>Domaine de Samanah · Route d’Amizmiz<br>Marrakech, Maroc</p>
      <a href="mailto:reservation@villacarissa-samanah.com">reservation@villacarissa-samanah.com</a>
      <a href="tel:+212668214728">+212 668 214 728</a>
    </div>
    <div class="contact-reservation">
      <span class="eyebrow">RÉSERVATIONS EXCLUSIVEMENT SUR AIRBNB</span>
      <h2>Vos dates.<br><em>Votre séjour.</em></h2>
      <p>Retrouvez les disponibilités, les tarifs et les conditions de séjour sur la fiche Airbnb de la villa. Le choix des dates, la réservation et le paiement se font directement sur Airbnb.</p>
      <a class="button" href={AIRBNB_URL} target="_blank" rel="noopener noreferrer">Voir les disponibilités sur Airbnb <span aria-hidden="true"><GolfBall /></span></a>
      <p>Besoin d’une précision avant de réserver&nbsp;?</p>
      <a class="text-link" href={AIRBNB_MESSAGE_URL} target="_blank" rel="noopener noreferrer">Poser une question à Willy sur Airbnb <span aria-hidden="true"><GolfBall /></span></a>
      <p class="booking-note">Les informations et disponibilités affichées sur Airbnb font référence pour votre réservation.</p>
    </div>
  </section>
</BaseLayout>
