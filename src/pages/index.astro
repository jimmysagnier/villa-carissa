---
import GolfBall from '../components/GolfBall.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import VillaDescription from '../components/VillaDescription.astro';
import VillaMosaic from '../components/VillaMosaic.astro';
import GuestReviews from '../components/GuestReviews.astro';
---
<BaseLayout title="Villa Carissa · Villa privée à Samanah, Marrakech" description="Une villa familiale à Marrakech, sur le golf de Samanah. 4 chambres, 4 salles de bain, 8 voyageurs et une piscine privée." currentPage="home">
<Hero />
<VillaDescription />
<VillaMosaic />
<section class="comfort section"><div><span class="eyebrow">L’ESSENTIEL EST DÉJÀ LÀ</span><h2>Posez vos valises.<br><em>Soufflez.</em></h2><p>Une maison équipée pour profiter des journées, avec toute la liberté d’être chez soi.</p></div><ul><li><span aria-hidden="true">≈</span>Piscine privée</li><li><span aria-hidden="true">❋</span>Climatisation</li><li><span aria-hidden="true">⌁</span>Wifi</li><li><span aria-hidden="true">◇</span>Cuisine</li><li><span aria-hidden="true">✧</span>Entretien sur place</li><li><span aria-hidden="true">☼</span>Linge de maison</li><li><span aria-hidden="true">♧</span>Jardin & terrasse</li><li><span aria-hidden="true">⌂</span>Parking</li></ul></section>
    <section class="golf-feature"><img src="/assets/photo-85.webp" alt="Le parcours du golf de Samanah face aux montagnes de l’Atlas" class="" loading="lazy" decoding="async" width="1403" height="937"><div class="golf-panel"><span class="eyebrow">LE GOLF POUR HORIZON</span><h2>Les golfs de Marrakech,<br><em>à votre rythme.</em></h2><p>Séjournez sur le domaine de Samanah et rejoignez le club-house en voiture. Entre deux parties, retrouvez le calme du jardin et de la piscine.</p><a class="text-link" href="/voyage-golfique-a-marrakech">Découvrir le golf de Samanah <span aria-hidden="true"><GolfBall /></span></a></div></section>
    <section class="city-section section"><div class="section-heading"><div><span class="eyebrow">LA VILLE ROUGE, TOUT PRÈS</span><h2>Marrakech,<br><em>au gré de vos envies.</em></h2></div><p>Une matinée dans les souks, un jardin à découvrir,<br>une échappée dans l’Atlas. Puis rentrer, au calme.</p></div><div class="city-grid"><a class="city-card" href="/location-de-villa-a-marrakech"><img src="/assets/photo-105.webp" alt="Se perdre dans les souks" class="" loading="lazy" decoding="async" width="1403" height="937"><div><span class="eyebrow">COULEURS & RENCONTRES</span><h3>Se perdre dans les souks <span aria-hidden="true"><GolfBall /></span></h3></div></a><a class="city-card" href="/location-de-villa-a-marrakech"><img src="/assets/photo-111.webp" alt="S’offrir une pause au jardin" class="" loading="lazy" decoding="async" width="1403" height="937"><div><span class="eyebrow">JARDIN MAJORELLE</span><h3>S’offrir une pause au jardin <span aria-hidden="true"><GolfBall /></span></h3></div></a><a class="city-card" href="/location-de-villa-a-marrakech"><img src="/assets/photo-113.webp" alt="Prendre la route de l’Atlas" class="" loading="lazy" decoding="async" width="1403" height="937"><div><span class="eyebrow">LA VALLÉE DE L’OURIKA</span><h3>Prendre la route de l’Atlas <span aria-hidden="true"><GolfBall /></span></h3></div></a></div><div class="center"><a class="text-link" href="/location-de-villa-a-marrakech">Notre carnet de Marrakech <span aria-hidden="true"><GolfBall /></span></a></div></section>
    <GuestReviews />
</BaseLayout>
